{
  "name": "orange-ludo",
  "version": "0.1.0",
  "private": true,
  "description": "A modular WeChat Mini Game implementation of classic Aeroplane Chess and future cargo modes.",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "analyze:classic": "pnpm build && node tools/analyze-classic.mjs",
    "build": "pnpm --filter @orange-ludo/game-core build",
    "check": "pnpm typecheck && pnpm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm --filter @orange-ludo/game-core typecheck"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
